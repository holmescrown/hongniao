# 复制本文件为 .env.local 后填写。所有变量留空时，前端自动使用本地 Demo 模式
# （账号与数据存浏览器 localStorage），无需后端即可体验完整流程。

# Supabase 项目地址：控制台 → Project Settings → API → Project URL
# 例：https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Supabase 匿名公钥：同一页面的 anon public key（不是 service_role key！）
# 前端只用 anon key，权限由数据库 RLS 策略控制。
VITE_SUPABASE_ANON_KEY=

# 游戏 WebSocket 服务地址（留空则由前端按当前域名自动推断）
# 例：ws://localhost:8787 或 wss://game.example.com
VITE_GAME_SERVER_URL=

# 逗号分隔的管理员邮箱，仅用于前端界面判断展示（真正权限以数据库 profiles.is_admin 为准）
# 例：admin@example.com,boss@example.com
VITE_ADMIN_EMAILS=
